# Ignore environment files
env/
.env

# Ignore secrets / API config (contains CORE API key when used locally)
src/model_devlopment_file/core_api_config.json

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo

# Ignore only Streamlit secrets (API keys) — the config.toml MUST be tracked so
# Streamlit Community Cloud picks up theme + maxUploadSize on deploy.
.streamlit/secrets.toml
main/.streamlit/secrets.toml

# Ignore virtual environments
venv/
test.py

# Ignore the ResearchClawBench reference clone (1.1GB, not part of the app)
ResearchClawBench/

# Graphify knowledge graph: commit the graph and its report; everything else in
# graphify-out/ (cache, HTML view, machine-specific paths) is rebuilt locally.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
